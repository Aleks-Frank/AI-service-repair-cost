API_KEY=
BITRIX_OUTBOUND_TOKEN=

APP_NAME=Repair Agent API
HOST=127.0.0.1
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
DATABASE_PATH=data/requests.sqlite3
MAX_REQUEST_BYTES=10485760
AI_ENABLED=true
AI_POLL_SECONDS=0.5
AI_QUEUE_LIMIT=100
AI_ENV_FILE=.env

BITRIX_ENTITY_ID_PATH=data.FIELDS.ID
BITRIX_INPUT_PATH=data.FIELDS

BITRIX_WEBHOOK_URL=
BITRIX_TIMEOUT_SECONDS=10

BITRIX_RESULT_METHOD=
BITRIX_RESULT_FIELD=
BITRIX_RESULT_STATIC_PARAMS={}
BITRIX_RESULT_ID_PARAM=id

